# Mapbox
# Required for the Travel Map feature
VITE_MAPBOX_ACCESS_TOKEN=""

# Google Gemini
# Required for the AI Chatbot feature
VITE_GEMINI_API_KEY=""

# Application Settings
# The email address allowed to log in to the management dashboard
VITE_ALLOWED_EMAIL="admin@domain.tld"

# Navigation Visibility
# Set to 'false' to hide a specific item from the navigation.
# Example: VITE_NAV_BLOG_VISIBLE=false
VITE_NAV_HOME_VISIBLE=true
VITE_NAV_BLOG_VISIBLE=true
VITE_NAV_VIDEOS_VISIBLE=true
VITE_NAV_GALLERY_VISIBLE=true
VITE_NAV_TRAVEL_VISIBLE=true
VITE_NAV_CHATBOT_VISIBLE=true
VITE_NAV_MANAGE_BLOG_VISIBLE=true
VITE_NAV_MANAGE_VIDEOS_VISIBLE=true
VITE_NAV_MANAGE_TRAVEL_VISIBLE=true
VITE_NAV_MANAGE_GALLERY_VISIBLE=true