# Supabase
VITE_SUPABASE_URL="YOUR_SUPABASE_URL"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Mapbox
VITE_MAPBOX_ACCESS_TOKEN="YOUR_MAPBOX_ACCESS_TOKEN"

# Google Gemini
VITE_GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Navigation Visibility Flags
# Set these to 'true' or 'false' to control which items appear in the navigation.
# If a variable is not set, it will use a default value.

# --- Main Navigation ---
VITE_NAV_HOME_VISIBLE="true"
VITE_NAV_BLOG_VISIBLE="true"
VITE_NAV_VIDEOS_VISIBLE="true"
VITE_NAV_GALLERY_VISIBLE="true"
VITE_NAV_TRAVEL_VISIBLE="true"
VITE_NAV_CHATBOT_VISIBLE="false"

# --- Management Navigation ---
VITE_NAV_MANAGE_BLOG_VISIBLE="true"
VITE_NAV_MANAGE_VIDEOS_VISIBLE="true"
VITE_NAV_MANAGE_TRAVEL_VISIBLE="true"
VITE_NAV_MANAGE_GALLERY_VISIBLE="true"